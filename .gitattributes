# Normalize line endings in the repository, so a Linux image built from this
# tree never meets a CRLF: the shell scripts in deploy/ die on it, and a
# CRLF-only mistake is invisible until the build does.
* text=auto

# run by bash wherever they are run
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# windows tooling keeps its own
*.bat text eol=crlf
*.cmd text eol=crlf

# never touched
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.wasm binary
*.unityweb binary