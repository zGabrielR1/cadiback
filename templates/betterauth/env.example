# Better Auth server (stateless, social sign-in only)
# Copy to the host's gitignored `.env.betterauth` and fill what you use.
# A missing provider block simply hides that button; a missing secret keeps
# the whole rail disabled, so a deploy without credentials stays healthy.

# The public origin of the auth server. Used as the baseURL fallback and
# added to trustedOrigins. Leave blank to infer from the request Host.
BETTER_AUTH_URL=
# >= 32 high-entropy characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Shared with the Python host; signs the social identity bridge.
BETTER_AUTH_BRIDGE_SECRET=
# Where the bridge POSTs the signed identity. Defaults to 127.0.0.1:$PORT.
BETTER_AUTH_BRIDGE_URL=
# Origins allowed to receive the browser at the end of the flow, and to make
# auth requests (comma separated). Include the Render and Vercel hosts.
BETTER_AUTH_TRUSTED_ORIGINS=
# Public provider labels are derived from the credentials below; this list is
# what the host reports before the auth server is reachable.
BETTER_AUTH_PROVIDERS=google,facebook,apple
# Optional: the Better Auth Infrastructure dashboard key (ba_...).
BETTER_AUTH_API_KEY=
# Internal port the host's web server proxies /api/betterauth/* to.
BETTER_AUTH_INTERNAL_PORT=3100
# Used by the auth server only; the host's own port for the bridge.
PORT=8765

# --- Google ---------------------------------------------------------------
# Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Redirect URI: https://<host>/api/betterauth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Facebook -------------------------------------------------------------
# developers.facebook.com > App settings > Basic (App ID / App Secret)
# Redirect URI: https://<host>/api/betterauth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Apple ----------------------------------------------------------------
# developer.apple.com > Identifiers > Services ID (this is the client id),
# plus the Sign in with Apple key (.p8), its Key ID, and your Team ID.
# Redirect URL: https://<host>/api/betterauth/callback/apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# The .p8 contents, newlines escaped as \n (single line) is easiest.
APPLE_PRIVATE_KEY=
# Optional: the native app bundle id, only for ID-token sign-in on iOS.
APPLE_APP_BUNDLE_IDENTIFIER=
