# Password hashing (foundry.auth.password)
# PBKDF2-HMAC-SHA256 work factor. Raise it over time; existing hashes keep
# verifying and `needs_rehash` tells the host when to upgrade one on login.
PASSWORD_PBKDF2_ITERATIONS=600000

# Sessions (foundry.auth.session)
# 12 hours for a normal login, 30 days for "remember me".
SESSION_TTL_SECONDS=43200
SESSION_REMEMBER_TTL_SECONDS=2592000

# Social login lives in templates/betterauth/env.example: the TypeScript auth
# server owns the providers and foundry.betterauth verifies its signed bridge.
# Copy that file instead when the host needs Google/Facebook/Apple.
