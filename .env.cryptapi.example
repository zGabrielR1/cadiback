# Public receiving addresses only. NEVER enter a seed phrase or private key.
# Leave a network blank to hide it from the cashier. No API key is needed.
CRYPTAPI_WALLET_BTC=
CRYPTAPI_WALLET_ETH=
CRYPTAPI_WALLET_LTC=
CRYPTAPI_WALLET_USDTTRC20=
CRYPTAPI_WALLET_USDTERC20=
CRYPTAPI_WALLET_USDC=
CRYPTAPI_CALLBACK_BASE=https://cadiback.onrender.com
# Obtain this value at https://cryptapi.io/verify_domain/ for cadiback.onrender.com.
# Paste the entire cryptapi-verification=... value after the first equals sign.
CRYPTAPI_VERIFICATION_TOKEN=
