# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# node — deliberately pruned between sessions; `npm ci` restores it
node_modules/
.next/
npm-debug.log*

# build output: the image builds it from web/ (Dockerfile stage 1)
web/out/

# deploy scratch: wrangler/miniflare local state, never credentials, but never
# belongs in a deployable tree either
.wrangler/
deploy/.wrangler/
# vercel link state (web/.vercel/): holds the project id and a CLI token —
# a deploy credential, never committed
.vercel/
web/.vercel/

# the live ledger, profiles, rounds and admin sessions — a deployment starts
# with its own (OPERATOR_DATA_DIR), and this is someone's play money history
demo/data/

# editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# local env / credentials. `.env.render` holds a live Render API key: a
# deploy credential must never reach the repository, and the tree is about to
# be pushed to a public repo.
.env
.env.*
!.env.example
!.env.template

# a runtime snapshot the sports stats engine writes (per-match cards, corners,
# fouls); a live cache, not a committed probe artifact like the fixtures feed
probes/flashscore-stats-cache.json