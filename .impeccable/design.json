  "components": [
    {
      "name": "Original selected odds",
      "kind": "button",
      "description": "Filled selection treatment in Original.",
      "html": "<button class=\"ds-original-odd\">1 <b>2.10</b></button>",
      "css": ".ds-original-odd{background:var(--acc,#b9f34b);color:var(--on-acc,#172207);border:1px solid var(--acc,#b9f34b);border-radius:8px;padding:8px 12px;min-height:48px;font:550 15px \"Geist Mono\",monospace;display:flex;gap:16px;transition:background-color 160ms}.ds-original-odd:hover{filter:brightness(.96)}.ds-original-odd:focus-visible{outline:2px solid var(--acc,#b9f34b);outline-offset:3px}",
      "refersTo": "original-odd-selected"
    },
    {
      "name": "Blue selected odds",
      "kind": "button",
      "description": "Solid ultramarine selection treatment in the separate local Blue build.",
      "html": "<button class=\"ds-blue-odd\"><span>1</span><b>2.10</b></button>",
      "css": ".ds-blue-odd{display:flex;justify-content:space-between;gap:24px;min-height:42px;padding:10px;border:1px solid #4263eb;border-radius:5px;background:#4263eb;color:#fff;font:600 14px Geist,Arial,sans-serif}.ds-blue-odd:hover{filter:brightness(1.06)}.ds-blue-odd:focus-visible{outline:2px solid var(--acc,#b9f34b);outline-offset:3px}",
      "refersTo": "blue-odd-selected"
    },
    {
      "name": "Search field",
      "kind": "input",
      "description": "Shared labeled search and focused container.",
      "html": "<label class=\"ds-search\">Buscar <input aria-label=\"Buscar partidas\" placeholder=\"Buscar partidas\" /></label>",
      "css": ".ds-search{display:flex;align-items:center;gap:9px;padding:0 12px;border:1px solid var(--line,#34383f);border-radius:8px;background:var(--field,#16181b);color:var(--mut,#adb2bd);font:13px Geist,Arial,sans-serif}.ds-search input{min-width:0;min-height:44px;border:0;background:transparent;color:var(--ink,#f4f5f7);font:inherit;outline:none}.ds-search:focus-within{outline:2px solid var(--acc,#8198ff);outline-offset:2px}",
      "refersTo": "search"
    },
    {
      "name": "Sports navigation",
      "kind": "nav",
      "description": "Horizontal navigation replaces the rail at compact widths.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Esportes\"><button aria-pressed=\"true\">Futebol</button><button>Basquete</button></nav>",
      "css": ".ds-nav{display:flex;gap:8px;font:13px Geist,Arial,sans-serif}.ds-nav button{min-height:44px;padding:8px 14px;border:1px solid var(--line,#34383f);border-radius:6px;background:var(--card,#1e2023);color:var(--ink,#f4f5f7);font:inherit}.ds-nav button[aria-pressed=\"true\"]{background:#4263eb;color:#fff}.ds-nav button:hover{border-color:var(--mut,#adb2bd)}.ds-nav button:focus-visible{outline:2px solid var(--acc,#b9f34b);outline-offset:3px}"
    },
    {
      "name": "Market filter",
      "kind": "chip",
      "description": "Compact explicit pressed-state filter.",
      "html": "<button class=\"ds-chip\" aria-pressed=\"true\">Ao vivo</button>",
      "css": ".ds-chip{min-height:40px;padding:8px 12px;background:var(--card,#1e2023);color:var(--ink,#f4f5f7);border:1px solid var(--line,#34383f);border-radius:5px;font:12px Geist,Arial,sans-serif}.ds-chip[aria-pressed=\"true\"]{border-color:var(--acc,#8198ff)}.ds-chip:hover{background:var(--chip,#292d35)}.ds-chip:focus-visible{outline:2px solid var(--acc,#b9f34b);outline-offset:3px}"
    },
    {
      "name": "Blue fixture highlight",
      "kind": "card",
      "description": "Paired team typography in a quiet bordered highlight.",
      "html": "<article class=\"ds-highlight\"><p>Futebol · Partida</p><h3>Equipe da casa<br>Equipe visitante</h3><small>Horário informado pela fonte</small></article>",
      "css": ".ds-highlight{padding:16px 20px;border:1px solid var(--line,#34383f);border-radius:7px;background:var(--card,#1e2023);color:var(--ink,#f4f5f7);font:12px Geist,Arial,sans-serif}.ds-highlight p,.ds-highlight small{color:var(--mut,#adb2bd)}.ds-highlight h3{font:600 21px/1.35 \"Barlow Condensed\",sans-serif;margin:18px 0}"
    },
    {
      "name": "Blue expandable filters",
      "kind": "custom",
      "description": "Compact competition/favorites/reset popup. On phones it is right aligned, opens above the summary and scrolls within the viewport.",
      "html": "<details class=\"ds-blue-filters\"><summary>Filtros</summary><div><label>Competição<select><option>Todas as competições</option></select></label><button>Favoritos</button><button>Limpar filtros</button></div></details>",
      "css": ".ds-blue-filters{position:relative;margin-left:auto;font:12px Geist,Arial,sans-serif;color:var(--ink,#f4f5f7)}.ds-blue-filters summary{cursor:pointer;min-height:36px;display:flex;align-items:center;padding:8px 12px;border:1px solid var(--line,#34383f);border-radius:5px}.ds-blue-filters>div{position:absolute;right:0;top:calc(100% + 8px);width:280px;max-width:calc(100vw - 32px);padding:16px;background:var(--card,#1e2023);border:1px solid var(--line,#34383f);border-radius:6px;box-shadow:0 8px 24px #0003;display:grid;gap:10px;z-index:10}.ds-blue-filters label{display:grid;gap:8px;color:var(--mut,#adb2bd)}.ds-blue-filters select,.ds-blue-filters button{min-height:40px;padding:8px;color:var(--ink,#f4f5f7);background:var(--field,#16181b);border:1px solid var(--line,#34383f);border-radius:5px;font:inherit}.ds-blue-filters button:hover{background:var(--chip,#292d35)}.ds-blue-filters summary:focus-visible,.ds-blue-filters button:focus-visible,.ds-blue-filters select:focus-visible{outline:2px solid var(--acc,#8198ff);outline-offset:3px}@media(max-width:760px){.ds-blue-filters{margin-left:auto}.ds-blue-filters summary{min-height:44px}.ds-blue-filters>div{top:auto;bottom:calc(100% + 8px);right:0;left:auto;max-height:calc(100dvh - 180px);overflow-y:auto}}"
    }
  ],
  "narrative": {
    "northStar": "The Familiar Sportsbook, Two Appearances",
    "overview": "Original is the default Candibet identity: near-black neutral layers, green actions, condensed sporting headlines and precise numeric data. Tournament Blue is a separate local build with graphite and cool-white surfaces, ultramarine actions, paired team highlights and aligned fixture rows. Each appearance supports dark and light themes.\n\nNormal builds pin Original. Tournament Blue is selected only at compile time with NEXT_PUBLIC_LOCAL_BLUE=1 and served separately by scripts/local_blue.py; it has an isolated temporary export and local account data. There is no appearance selector, query activation or stored appearance preference. Only the light/dark preference persists. Portuguese content, honest source distinctions and working account, wallet and selection flows remain the product foundation. The current source of truth is the cascade globals.css → workspace.css → apex.css → variants.css; Clubhouse and Nunito are archived development history, not active design guidance.",
    "keyCharacteristics": [
      "Original defaults to green and near-black; Blue is an explicit alternate.",
      "Compact sports data with readable state and provenance.",
      "Production Original and local-only Blue, each with light/dark support.",
      "Local Geist, Barlow Condensed and Geist Mono assets with fixed functional roles."
    ],
    "rules": [
      {
        "name": "Build Boundary Rule",
        "body": "Normal builds are Original; Blue is compile-time local-only. Theme remains an independent persisted preference. Never reactivate Blue in production through browser state.",
        "section": "colors"
      },
      {
        "name": "Data State Rule",
        "body": "Selected, unavailable, loading and failed markets must remain distinguishable in both appearances and both themes.",
        "section": "colors"
      },
      {
        "name": "Three Roles Rule",
        "body": "Original uses Geist for interface text, Barlow Condensed for display and Geist Mono for figures. Mono is a numeric role, never an additional decorative voice. Blue uses Geist for functional headings, body and figures, retaining Barlow Condensed for team names.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do preserve Original in normal production builds and keep Blue isolated locally.",
      "Do use the active semantic variables so every surface works in both themes.",
      "Do retain tabular figures, explicit selection state and truthful missing-data fallbacks.",
      "Do keep keyboard focus visible and honor reduced motion."
    ],
    "donts": [
      "Don't import archived Clubhouse styling or Nunito into the active cascade.",
      "Don't expose browser query, storage or selector activation for Blue in production.",
      "Don't add a fourth decorative type voice or spread Mono into body copy.",
      "Don't invent statistics, popularity, volume or promotional claims."
    ]
  }
}
